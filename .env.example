# Copy to .env (gitignored). Matches docker-compose.yml.
DATABASE_URL=postgres://obsidian:obsidian@localhost:5433/obsidian_cube

# Admin auth (Etapa 4). SESSION_SECRET must be a long random string in real use.
# ADMIN_* seeds the first admin user on boot if the table is empty; the password
# is stored only as a bcrypt hash. MFA (TOTP) is enrolled on first login.
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Phase (owner, 2026-10-18): development until the owner says the site goes to
# production. In development the publish rules warn; in production they block.
# Unset means development; any other value stops the server.
APP_ENV=development

# Login bypass for agentic work (owner, 2026-10-18): off lets local requests use
# the admin without logging in. Only with APP_ENV=development; with production
# the server refuses to start. Default on.
ADMIN_AUTH=on

# Clone of the private repository that npm run backup:content writes to
# CONTENT_BACKUP_DIR=../obsidian-cube-content
