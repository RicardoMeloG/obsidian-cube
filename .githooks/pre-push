#!/bin/sh
# Before anything leaves the machine: the privacy check (spec 010, H-08a) and
# the proportional gates of what the push carries (spec 012).
# Enabled by `npm install` (scripts/enable-hooks.mjs).
input=$(cat)
npm run --silent check:privacy || exit 1
printf '%s\n' "$input" | node scripts/check-push.mjs "$1"
