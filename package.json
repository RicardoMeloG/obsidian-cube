{
  "name": "obsidian-cube",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "check:layout": "node scripts/check-layout.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:live": "node scripts/check-live.mjs",
    "report:objective": "node scripts/report-objective.mjs",
    "server": "ts-node --project server/tsconfig.json server/main.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.17",
    "express-session": "^1.19.0",
    "lucide-react": "^1.57.0",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.12.3",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
